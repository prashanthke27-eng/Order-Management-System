# Copy to .env (local) or set as environment variables on your host.
# NEVER commit a real .env file.

# Required in production (server refuses to boot without it when NODE_ENV=production)
JWT_SECRET=change-this-to-a-long-random-string

# Hosting platform port (Render/Railway set PORT automatically)
PORT=3000

# SQLite file location. On Render, use the persistent disk path /data/erp.db
DB_PATH=./data/erp.db

# Staff login seed is admin/admin123 + staff/staff123 — change after first login.
